{
  "info": {
    "name": "Hotel Booking Management System",
    "description": "Postman collection for Hotel/Room/Guest/Booking/Payment API. Disable SSL certificate verification in Postman when using self-signed certificate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "managerToken", "value": "", "type": "string" },
    { "key": "guestToken", "value": "", "type": "string" },
    { "key": "adminRefreshToken", "value": "", "type": "string" },
    { "key": "hotelId", "value": "", "type": "string" },
    { "key": "roomId", "value": "", "type": "string" },
    { "key": "guestId", "value": "", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "paymentId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin1234!\",\n  \"role\": \"ROLE_ADMIN\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 409', function () { pm.expect([201,409]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Manager",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager1\",\n  \"password\": \"Manager1234!\",\n  \"role\": \"ROLE_MANAGER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 409', function () { pm.expect([201,409]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register Guest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"guest1\",\n  \"password\": \"Guest1234!\",\n  \"role\": \"ROLE_GUEST\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 409', function () { pm.expect([201,409]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin1234!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Manager",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"manager1\",\n  \"password\": \"Manager1234!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('managerToken', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Guest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"guest1\",\n  \"password\": \"Guest1234!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('guestToken', json.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Admin Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.accessToken);",
                  "pm.collectionVariables.set('adminRefreshToken', json.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Setup Data",
      "item": [
        {
          "name": "Create Hotel",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Hotel {{$timestamp}}\",\n  \"city\": \"Moscow\",\n  \"address\": \"Postman Street, 1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(201);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('hotelId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Room",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": {{hotelId}},\n  \"roomNumber\": \"R{{$timestamp}}\",\n  \"type\": \"DELUXE\",\n  \"capacity\": 2,\n  \"pricePerNight\": 10500,\n  \"active\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(201);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('roomId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Guest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/guests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "guests"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Guest\",\n  \"email\": \"postman{{$timestamp}}@example.com\",\n  \"phone\": \"+7900{{$timestamp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(201);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('guestId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"guestId\": {{guestId}},\n  \"checkInDate\": \"2030-06-10\",\n  \"checkOutDate\": \"2030-06-14\",\n  \"notes\": \"Created from Postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(201);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Overlap Booking (Expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"guestId\": {{guestId}},\n  \"checkInDate\": \"2030-06-12\",\n  \"checkOutDate\": \"2030-06-15\",\n  \"notes\": \"Overlap test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', function () { pm.expect(pm.response.code).to.eql(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Change Booking Dates",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/dates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "dates"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkInDate\": \"2030-06-11\",\n  \"checkOutDate\": \"2030-06-15\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Booking By Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Confirm Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "confirm"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": {{bookingId}},\n  \"amount\": 42000,\n  \"currency\": \"RUB\",\n  \"method\": \"CARD\",\n  \"transactionReference\": \"PAY-{{$timestamp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(201);",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('paymentId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Payments By Booking",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "booking", "{{bookingId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Get Available Rooms",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/hotels/{{hotelId}}/available-rooms?checkInDate=2030-06-11&checkOutDate=2030-06-15",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels", "{{hotelId}}", "available-rooms"],
              "query": [
                { "key": "checkInDate", "value": "2030-06-11" },
                { "key": "checkOutDate", "value": "2030-06-15" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Hotel Occupancy Report",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reports/hotels/{{hotelId}}/occupancy?fromDate=2030-06-01&toDate=2030-06-30",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "hotels", "{{hotelId}}", "occupancy"],
              "query": [
                { "key": "fromDate", "value": "2030-06-01" },
                { "key": "toDate", "value": "2030-06-30" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Booking Lifecycle",
      "item": [
        {
          "name": "Complete Booking (Manager)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "complete"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Cancel Booking (Guest)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{guestToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 or 400', function () { pm.expect([200,400]).to.include(pm.response.code); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}

